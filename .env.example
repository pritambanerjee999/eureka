# LiveKit Cloud — https://cloud.livekit.io
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_URL=wss://your-project.livekit.cloud

# OpenAI (STT + LLM + TTS)
OPENAI_API_KEY=your_openai_api_key

# Redis — session metadata only (short-lived)
REDIS_URL=redis://redis:6379

# PostgreSQL — persistent conversation history
DATABASE_URL=postgresql://eureka:eureka@postgres:5432/eureka
POSTGRES_PASSWORD=eureka

# Frontend — URL the browser uses to reach the API (must be accessible from user's machine)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Signs user login tokens — generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
