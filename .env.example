# LiveKit Cloud — https://cloud.livekit.io → your project → Settings → API keys
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_URL=wss://your-project.livekit.cloud

# OpenAI — Whisper (speech-to-text), GPT-4o (tutor), TTS (voice), study-plan suggestions
OPENAI_API_KEY=your_openai_api_key

# Redis — live session state and each room's conversation (compose service name; leave as is)
REDIS_URL=redis://redis:6379

# PostgreSQL — users, durable per-user history and notes (compose service; leave as is)
DATABASE_URL=postgresql://eureka:eureka@postgres:5432/eureka
POSTGRES_PASSWORD=eureka

# Frontend — URL the browser uses to reach the API. Baked in at build time:
# rebuild the frontend (docker compose up --build) after changing it.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Signs user login tokens. REQUIRED, at least 32 chars — generate with: openssl rand -hex 32
JWT_SECRET=change-me-run-openssl-rand-hex-32

# Guardrails (optional — defaults shown)
# Browser origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:3000
# Max sessions a user can start per minute
TOKEN_RATE_LIMIT_PER_MINUTE=5
# Model that suggests the next three topics ("Plan my next lesson")
STUDY_PLAN_MODEL=gpt-4o-mini
# Max study-plan requests a user can make per minute
STUDY_PLAN_RATE_LIMIT_PER_MINUTE=10
# Hard cap on a voice session's length, in seconds
MAX_SESSION_SECONDS=1800
# End the session after this many seconds of the student not speaking
USER_AWAY_SECONDS=180
# End a session that stays paused this long
MAX_PAUSE_SECONDS=600
# How long a login lasts, in hours (7 days)
JWT_EXPIRE_HOURS=168
# Agent worker name; the API dispatches this name (shared by api and agent)
AGENT_NAME=eureka-tutor
